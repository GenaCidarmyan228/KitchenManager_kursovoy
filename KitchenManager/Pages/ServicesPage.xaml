<Page x:Class="KitchenManager.Pages.ServicesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:KitchenManager"
      mc:Ignorable="d" 
      
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Услуги" Loaded="Page_Loaded">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <Button Content=" Назад" Width="80" Height="30" Margin="0,0,20,0" Click="BtnBack_Click" />
            <Button Content="Добавить услугу" Width="150" Height="30" Margin="0,0,10,0" Click="BtnAdd_Click"/>
            <Button Content="Удалить" Width="100" Height="30" Click="BtnDelete_Click"/>
            
        </StackPanel>

        <DataGrid x:Name="DGridServices" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Margin="10" BorderBrush="Gray" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название услуги" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Стоимость" Binding="{Binding Price, StringFormat=N2}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
