<Page x:Class="KitchenManager.EmployeesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Сотрудники" Loaded="Page_Loaded" Background="{StaticResource MainBackground}" >

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <Button Content="Добавить" Width="120" Height="30" Margin="0,0,10,0" Click="BtnAdd_Click" Style="{StaticResource GreenBtnStyle}"/>

            <Button Content="Изменить" Width="100" Height="30" Margin="0,0,10,0" Click="BtnEdit_Click" Style="{StaticResource MenuButtonStyle}"/>

            <Button Content="+ Должность" Width="100" Height="30" Margin="0,0,10,0" Click="BtnAddPosition_Click" Style="{StaticResource GreenBtnStyle}"/>

            <Button Content="Удалить" Width="100" Height="30" Click="BtnDelete_Click" Style="{StaticResource RedBtnStyle}"/>
        </StackPanel>

        <DataGrid x:Name="DGridEmployees" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Margin="10" BorderBrush="Gray" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Фамилия" Binding="{Binding Surname}" Width="*"/>
                <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Отчество" Binding="{Binding Patronymic}" Width="*"/>
                <DataGridTextColumn Header="Должность" Binding="{Binding Positions.PositionName}" Width="150"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>