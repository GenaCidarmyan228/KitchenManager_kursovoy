<Page x:Class="KitchenManager.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:KitchenManager"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage">

    <Grid Background="{StaticResource MainBackground}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
            <TextBlock Text="Добро пожаловать," FontSize="24" HorizontalAlignment="Center"/>
            <TextBlock Text="сотрудник!" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Логин" FontSize="22" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtLogin" Grid.Column="1"/>
            </Grid>

            <Grid Margin="0,0,0,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Пароль" FontSize="22" VerticalAlignment="Center"/>
                <PasswordBox x:Name="TxtPassword" Grid.Column="1" Height="25"/>
            </Grid>

            <Button Content="Войти" Click="BtnLogin_Click" Width="140" Height="30" />
        </StackPanel>
        <Image Source="/Resources/unnamed.png" Stretch="Fill" Width="251" Height="132" HorizontalAlignment="Center" VerticalAlignment="Top" />
    </Grid>
</Page>
