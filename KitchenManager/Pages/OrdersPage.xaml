<Page x:Class="KitchenManager.Pages.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:KitchenManager"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OrdersPage"
    Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10" Cursor="">
            <Button Content="Изменить данные" Click="BtnEdit_Click" Width="120" Margin="0,0,10,0" />
            <Button Content="Удалить" Click="BtnDelete_Click" Width="120" Margin="0,0,10,0"  />
            <Button Content="Добавить Новый Заказ" Click="BtnAdd_Click" Style="{StaticResource GreenBtnStyle}" Width="170" Margin="0,0,10,0" />
        </StackPanel>

        <DataGrid x:Name="DGridOrders" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                  Background="White" BorderBrush="Black" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding ID_Order}" Width="40"/>

                <DataGridTextColumn Header="Дата" Binding="{Binding OrderDate, StringFormat=dd.MM.yyyy}" Width="90"/>

                <DataGridTextColumn Header="Статус" Binding="{Binding OrderStatus.StatusName}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Background" Value="{Binding StatusColor}"/>
                            <Setter Property="Padding" Value="5,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Клиент" Binding="{Binding ClientFullName}" Width="200"/>

                <DataGridTextColumn Header="Сотрудник" Binding="{Binding EmployeeFullName}" Width="180"/>

                <DataGridTextColumn Header="Сумма" Binding="{Binding TotalPrice, StringFormat=N2}" Width="100" FontWeight="Bold"/>

                <DataGridTextColumn Header="Товар" Binding="{Binding Equipment.Title}" Width="*"/>
                <DataGridTextColumn Header="Услуга" Binding="{Binding Services.Title}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
