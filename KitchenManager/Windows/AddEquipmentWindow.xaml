<Window x:Class="KitchenManager.Windows.AddEquipmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар" Height="420" Width="300"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource MainBackground}">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Данные о товаре" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Название:"/>
            <TextBox Text="{Binding Title}" Height="25" Margin="0,0,0,10"/>

            <TextBlock Text="Описание:"/>
            <TextBox Text="{Binding Description}" Height="25" Margin="0,0,0,10"/>

            <TextBlock Text="Цена (руб):"/>
            <TextBox Text="{Binding Price}" Height="25" Margin="0,0,0,10"/>

            <TextBlock Text="Количество на складе:"/>
            <TextBox Text="{Binding StockQuantity}" Height="25" Margin="0,0,0,10"/>

            <Button Content="Сохранить" Click="BtnSave_Click" Style="{StaticResource GreenBtnStyle}" Height="35" Margin="0,15,0,0"/>
        </StackPanel>
    </Grid>
</Window>