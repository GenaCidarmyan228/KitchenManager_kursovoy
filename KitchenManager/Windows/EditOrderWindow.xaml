<Window x:Class="KitchenManager.Windows.EditOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование заказа" Height="460" Width="330" MinHeight="460" MinWidth="330"
        WindowStartupLocation="CenterScreen" 
        Loaded="Window_Loaded"
      >

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Редактирование заказа" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Статус заказа:" FontWeight="Bold"/>
            <ComboBox x:Name="ComboStatus" DisplayMemberPath="StatusName" SelectedValuePath="ID_Status" Margin="0,0,0,15" Height="30"/>

            <TextBlock Text="Клиент:"/>
            <ComboBox x:Name="ComboClients" DisplayMemberPath="FullName" SelectedValuePath="ID_Client" Margin="0,0,0,10" Height="25"/>

            <TextBlock Text="Оборудование:"/>
            <ComboBox x:Name="ComboEquipment" DisplayMemberPath="Title" SelectedValuePath="ID_Equipment" Margin="0,0,0,10" Height="25"/>

            <TextBlock Text="Услуга:"/>
            <ComboBox x:Name="ComboServices" DisplayMemberPath="Title" SelectedValuePath="ID_Service" Margin="0,0,0,10" Height="25"/>

            <TextBlock Text="Менеджер:"/>
            <ComboBox x:Name="ComboEmployees" DisplayMemberPath="FullName" SelectedValuePath="ID_Employee" Margin="0,0,0,20" Height="25"/>

            <Button Content="Сохранить изменения" Height="40" Click="BtnSave_Click" Style="{StaticResource GreenBtnStyle}"/>
        </StackPanel>
    </Grid>
</Window>