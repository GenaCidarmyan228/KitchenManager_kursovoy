<Window x:Class="KitchenManager.Windows.AddOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новый заказ" Height="440" Width="430" MinHeight="440" MinWidth="430"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <TextBlock Text="Клиент:" Margin="0,5,0,15" FontSize="16"/>
            <TextBlock Text="Товар:" Margin="0,5,0,15" FontSize="16"/>
            <TextBlock Text="Услуга:" Margin="0,5,0,15" FontSize="16"/>
            <TextBlock Text="Сотрудник:" Margin="0,5,0,15" FontSize="16"/>
        </StackPanel>

        <StackPanel Grid.Column="1">
            <ComboBox x:Name="ComboClients" DisplayMemberPath="FullName" SelectedValuePath="ID_Client" Height="25" Margin="0,0,0,10"/>
            <ComboBox x:Name="ComboEquipment" DisplayMemberPath="Title" SelectedValuePath="ID_Equipment" Height="25" Margin="0,0,0,10"/>
            <ComboBox x:Name="ComboServices" DisplayMemberPath="Title" SelectedValuePath="ID_Service" Height="25" Margin="0,0,0,10"/>
            <ComboBox x:Name="ComboEmployees" DisplayMemberPath="FullName" SelectedValuePath="ID_Employee" Height="25" Margin="0,0,0,20"/>


            <Button Content="Сохранить заказ" Click="BtnSave_Click" Style="{StaticResource GreenBtnStyle}" Height="40" Width="200" HorizontalAlignment="Left"/>
        </StackPanel>
    </Grid>
</Window>