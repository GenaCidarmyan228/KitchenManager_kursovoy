<Window x:Class="KitchenManager.AddClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Клиент" Height="420" Width="300"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
         Icon="/Resources/unnamed.png" 
        Background="{StaticResource MainBackground}">

    <StackPanel Margin="15">
        <TextBlock Text="Данные клиента" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <TextBlock Text="Фамилия:"/>
        <TextBox Text="{Binding Surname}" Height="25" Margin="0,0,0,10"/>

        <TextBlock Text="Имя:"/>
        <TextBox Text="{Binding Name}" Height="25" Margin="0,0,0,10"/>

        <TextBlock Text="Отчество:"/>
        <TextBox Text="{Binding Patronymic}" Height="25" Margin="0,0,0,10"/>

        <TextBlock Text="Телефон:"/>
        <TextBox Text="{Binding Phone}" Height="25" Margin="0,0,0,10"/>

        <TextBlock Text="Адрес:"/>
        <TextBox Text="{Binding Address}" Height="25" Margin="0,0,0,10"/>

        <Button Content="Сохранить" Height="35" Margin="0,15,0,0" Click="BtnSave_Click" Style="{StaticResource GreenBtnStyle}"/>
    </StackPanel>
</Window>