<Window x:Class="KitchenManager.Windows.AddPositionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новая должность" Height="200" Width="300"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource MainBackground}">

    <StackPanel Margin="20">
        <TextBlock Text="Название должности:" FontWeight="Bold" Margin="0,0,0,10"/>

        <TextBox x:Name="TxtName" Height="30" Margin="0,0,0,20"/>

        <Button Content="Добавить" Click="BtnAdd_Click" Style="{StaticResource GreenBtnStyle}" Height="35"/>
    </StackPanel>
</Window>